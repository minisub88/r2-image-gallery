{
  "$schema": "https://www.schemastore.org/wrangler",
  "name": "r2-image-gallery",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "outside"
    }
  ]
}
